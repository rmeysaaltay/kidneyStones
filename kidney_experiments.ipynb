# ---------------- Veri seti oluşturma ----------------
def build_dataset(src, dst, transform=None):
    """src'yi dst'ye kopyalar. transform verilirse train/valid/test'in tüm görüntülerine uygulanır."""
    if os.path.exists(dst):
        shutil.rmtree(dst)
    for split in ("train", "valid", "test"):
        os.makedirs(f"{dst}/{split}/images")
        os.makedirs(f"{dst}/{split}/labels")
        for f in os.listdir(f"{src}/{split}/images"):
            s, d = f"{src}/{split}/images/{f}", f"{dst}/{split}/images/{f}"
            if transform is None:
                shutil.copy2(s, d)
            else:
                img = cv2.imread(s)
                if img is None:
                    continue
                cv2.imwrite(d, transform(img), [cv2.IMWRITE_JPEG_QUALITY, 100])
            lbl = os.path.splitext(f)[0] + ".txt"
            ls = f"{src}/{split}/labels/{lbl}"
            if os.path.exists(ls):
                shutil.copy2(ls, f"{dst}/{split}/labels/{lbl}")
    cfg = {"path": dst, "train": "train/images", "val": "valid/images",
           "test": "test/images", "nc": 4, "names": NAMES}
    yaml_path = f"{dst}/data.yaml"
    with open(yaml_path, "w") as fh:
        yaml.dump(cfg, fh, sort_keys=False)
    print(f"{dst}: hazır")
    return yaml_path


def class_counts(root, split="train"):
    counts = {n: 0 for n in NAMES.values()}
    for f in os.listdir(f"{root}/{split}/labels"):
        for line in open(f"{root}/{split}/labels/{f}").read().splitlines():
            if line.strip():
                counts[NAMES[int(line.split()[0])]] += 1
    return counts


# ---------------- Ön işleme fonksiyonları ----------------
def clahe_t(img):
    lab = cv2.cvtColor(img, cv2.COLOR_BGR2LAB)
    l, a, b = cv2.split(lab)
    l = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8)).apply(l)
    return cv2.cvtColor(cv2.merge((l, a, b)), cv2.COLOR_LAB2BGR)

def median_t(img):
    return cv2.medianBlur(img, 5)

def bilateral_t(img):
    return cv2.bilateralFilter(img, 9, 75, 75)


# ---------------- Focal Loss ----------------
class FocalBCE(nn.Module):
    def __init__(self, gamma=1.5):
        super().__init__()
        self.gamma = gamma

    def forward(self, pred, true):
        bce = F.binary_cross_entropy_with_logits(pred, true, reduction="none")
        p = pred.sigmoid()
        p_t = true * p + (1 - true) * (1 - p)
        return bce * (1 - p_t) ** self.gamma


FOCAL_COUNT = {"applied": 0}

@contextmanager
def focal_loss_patch(gamma=1.5):
    """Eğitim süresince sınıflandırma kaybını Focal Loss ile değiştirir."""
    orig_init = ul_loss.v8DetectionLoss.__init__
    FOCAL_COUNT["applied"] = 0

    def patched(self, *a, **k):
        orig_init(self, *a, **k)
        if hasattr(self, "bce"):
            self.bce = FocalBCE(gamma)
            FOCAL_COUNT["applied"] += 1

    ul_loss.v8DetectionLoss.__init__ = patched
    try:
        yield
    finally:
        ul_loss.v8DetectionLoss.__init__ = orig_init


def strip_criterion(path):
    """Özel loss sınıfı ağırlık dosyasına gömülmesin (PyCharm'da yüklenebilsin diye)."""
    if not os.path.exists(path):
        return
    ck = torch.load(path, map_location="cpu", weights_only=False)
    for k in ("model", "ema"):
        if ck.get(k) is not None and hasattr(ck[k], "criterion"):
            ck[k].criterion = None
    torch.save(ck, path)


# ---------------- Eğitim + test değerlendirmesi ----------------
def run_experiment(group, name, yaml_path, require_focal=False, **extra):
    run_dir = f"{DRIVE_EXP}/{group}"
    best = f"{run_dir}/{name}/weights/best.pt"
    json_path = f"{run_dir}/{name}/metrics.json"

    # Daha önce tamamlanmışsa sonucu doğrudan yükle
    if os.path.exists(json_path):
        row = json.load(open(json_path))
        RESULTS.append(row)
        print(f"[{group}/{name}] kayıtlı sonuç yüklendi | mAP50={row['mAP50']:.4f}")
        return row

    if not os.path.exists(best):
        m = YOLO(MODEL)
        args = dict(data=yaml_path, epochs=EPOCHS, imgsz=IMGSZ, batch=BATCH,
                    patience=PATIENCE, seed=SEED, cache="ram", workers=2,
                    project=run_dir, name=name, exist_ok=True, plots=False, **NO_AUG)
        args.update(extra)
        m.train(**args)
        if require_focal and FOCAL_COUNT["applied"] == 0:
            raise RuntimeError("Focal Loss yaması uygulanamadı (v8DetectionLoss.bce bulunamadı). "
                               "Bu sürümde sonuç baz modelle aynı olurdu.")
        strip_criterion(best)
        strip_criterion(f"{run_dir}/{name}/weights/last.pt")

    bm = YOLO(best)
    met = bm.val(data=yaml_path, split="test", imgsz=IMGSZ, batch=1, plots=False,
                 project=run_dir, name=name + "_test", exist_ok=True, verbose=False)
    b = met.box
    total_ms = float(sum(met.speed.values()))
    row = dict(grup=group, ad=name,
               mAP50=float(b.map50), mAP50_95=float(b.map), P=float(b.mp), R=float(b.mr),
               ms_per_img=total_ms, FPS=1000 / total_ms)
    for i, c in enumerate(b.ap_class_index):
        p, r, ap50, ap = b.class_result(i)
        row[f"AP50_{bm.names[c]}"] = float(ap50)
        row[f"R_{bm.names[c]}"] = float(r)

    json.dump(row, open(json_path, "w"))
    RESULTS.append(row)
    print(f"[{group}/{name}] mAP50={row['mAP50']:.4f} | mAP50-95={row['mAP50_95']:.4f}")
    return row
CLEAN_YAML = build_dataset(RAW, f"{WORK}/clean")
print("Train sınıf dağılımı (kutu sayısı):", class_counts(f"{WORK}/clean"))

run_experiment("baseline", "yolov8n_ham", CLEAN_YAML)
