# (a) Sınıf ağırlıklandırma: cls_pw sınıf frekansına göre kayıp ağırlığı üssüdür (0 = kapalı)
run_experiment("exp3_imbalance", "yolov8n_classweight", CLEAN_YAML, cls_pw=1.0)

# (b) Focal Loss
with focal_loss_patch(gamma=1.5):
